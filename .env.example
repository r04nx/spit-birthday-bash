# Birthday Email Sender Configuration
# Copy this file to .env and fill in your details

# Gmail Configuration
GMAIL_EMAIL=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password

# Sender Name (appears in "From" field)
SENDER_NAME=SPIT Birthday Team

# Optional: Change the schedule time (default is 01:00)
SCHEDULE_TIME=01:00
